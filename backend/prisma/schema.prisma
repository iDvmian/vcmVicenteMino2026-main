generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GESTOR_VCM
  ENCARGADO_CARRERA
  DOCENTE
  DECANO
  CLIENTE
}

enum EtapaSeguimiento {
  SOLICITUD_CREADA
  SOLICITUD_APROBADA
  SOLICITUD_RECHAZADA
  PLANTEAMIENTO_CREADO
  PLANTEAMIENTO_APROBADO
  PLANTEAMIENTO_RECHAZADO
  PLANTEAMIENTO_REENVIADO
  PROYECTO_CREADO
  PROYECTO_EN_PROCESO
  PROYECTO_PAUSADO
  PROYECTO_FINALIZADO
  PROYECTO_CANCELADO
}

enum OrigenSolicitud {
  EXTERNA
  DOCENTE
}

enum TipoCliente {
  JUNTA_VECINOS
  ONG
  ESTABLECIMIENTO_EDUCACIONAL
  EMPRESA_PRIVADA
  ORGANISMO_PUBLICO
  PERSONA_NATURAL
  OTRO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoPlanteamiento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoProyecto {
  EN_PROCESO
  PAUSADO
  FINALIZADO
  CANCELADO
}

enum UnidadDuracion {
  DIAS
  SEMANAS
  MESES
}

enum TipoIntervencion {
  CHARLA
  TALLER
  CURSO_CAPACITACION
  SEMINARIO
  ASESORIA_TECNICA
  OPERATIVO_TERRENO
  APRENDIZAJE_SERVICIO
  ACTIVIDAD_CULTURAL
  VOLUNTARIADO
  INVESTIGACION_APLICADA
  OTRO
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  rut       String   @unique
  nombres   String
  apellidos String
  email     String   @unique
  telefono  String?
  password  String
  rol       Role     @default(CLIENTE)
  estado    Boolean  @default(true)
  carreraId Int?
  carrera   Carrera? @relation(fields: [carreraId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudesComoCliente    Solicitud[]     @relation("ClienteSolicitud")
  planteamientosComoDocente Planteamiento[] @relation("DocentePlanteamiento")
  historialEtapas           HistorialEtapa[] @relation("UsuarioHistorial")
  observacionesComoAutor    Observacion[]   @relation("AutorObservacion")
}

model Facultad {
  id        Int       @id @default(autoincrement())
  nombre    String
  etiqueta  String    @unique
  carreras  Carrera[]
  createdAt DateTime  @default(now())
}

model Carrera {
  id         Int                @id @default(autoincrement())
  nombre     String
  etiqueta   String             @unique
  facultadId Int
  facultad   Facultad           @relation(fields: [facultadId], references: [id])
  usuarios   User[]
  alumnos    AlumnoVoluntario[]
  solicitudes Solicitud[]
  createdAt  DateTime           @default(now())
}

model AlumnoVoluntario {
  id        Int              @id @default(autoincrement())
  rut       String           @unique
  nombres   String
  apellidos String
  email     String           @unique
  telefono  String?
  carreraId Int
  carrera   Carrera          @relation(fields: [carreraId], references: [id])
  estado    Boolean          @default(true)
  proyectos ProyectoAlumno[]
  createdAt DateTime         @default(now())
}

model Solicitud {
  id          Int               @id @default(autoincrement())
  titulo      String
  descripcion String            @db.Text
  ciudad      String?  
  direccion   String?
  numeroDireccion String?
  telefono    String?
  estado      EstadoSolicitud   @default(PENDIENTE)
  motivoRechazo String?         @db.Text
  tipoCliente TipoCliente?
  tipoClienteOtro String?       @db.VarChar(100)
  origen      OrigenSolicitud   @default(EXTERNA)
  nombreOrganizacion String?    @db.VarChar(150)
  personasPrevistas  Int?
  carreraId   Int?
  carrera     Carrera?          @relation(fields: [carreraId], references: [id])
  clienteId   Int
  cliente     User              @relation("ClienteSolicitud", fields: [clienteId], references: [id])
  archivos    ArchivoSolicitud[]
  planteamiento Planteamiento?
  historial   HistorialEtapa[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ArchivoSolicitud {
  id          Int       @id @default(autoincrement())
  url         String
  publicId    String
  nombre      String
  solicitudId Int
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
}

model Planteamiento {
  id             Int                   @id @default(autoincrement())
  descripcion    String                @db.Text
  tiempoEstimado String
  duracionCantidad      Int?
  duracionUnidad        UnidadDuracion?
  horasHombre           Int?
  tipoIntervencion      TipoIntervencion?
  tipoIntervencionOtro  String?
  estado         EstadoPlanteamiento   @default(PENDIENTE)
  motivoRechazo  String?               @db.Text
  solicitudId    Int                   @unique
  solicitud      Solicitud             @relation(fields: [solicitudId], references: [id])
  docenteId      Int
  docente        User                  @relation("DocentePlanteamiento", fields: [docenteId], references: [id])
  archivos       ArchivoPlanteamiento[]
  proyecto       Proyecto?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ArchivoPlanteamiento {
  id              Int           @id @default(autoincrement())
  url             String
  publicId        String
  nombre          String
  planteamientoId Int
  planteamiento   Planteamiento @relation(fields: [planteamientoId], references: [id])
}

model Proyecto {
  id              Int              @id @default(autoincrement())
  estado          EstadoProyecto   @default(EN_PROCESO)
  fechaInicio     DateTime
  fechaFin        DateTime
  participantesDocentes     Int?
  participantesEstudiantes  Int?
  participantesDocentesExternos Int?
  participantesAlumnosExternos  Int?
  participantesOtrosExternos    Int?
  planteamientoId Int              @unique
  planteamiento   Planteamiento    @relation(fields: [planteamientoId], references: [id])
  alumnos         ProyectoAlumno[]
  observaciones   Observacion[]
  archivos        ArchivoProyecto[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ArchivoProyecto {
  id         Int      @id @default(autoincrement())
  url        String
  publicId   String
  nombre     String
  proyectoId Int
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  createdAt  DateTime @default(now())
}

model ProyectoAlumno {
  proyectoId Int
  alumnoId   Int
  proyecto   Proyecto         @relation(fields: [proyectoId], references: [id])
  alumno     AlumnoVoluntario @relation(fields: [alumnoId], references: [id])

  @@id([proyectoId, alumnoId])
}

model Observacion {
  id          Int      @id @default(autoincrement())
  descripcion String   @db.Text
  proyectoId  Int
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id])
  autorId     Int
  autor       User     @relation("AutorObservacion", fields: [autorId], references: [id])
  createdAt   DateTime @default(now())
}

/// Seguimiento: una fila por cada hito de una iniciativa (solicitud -> planteamiento -> proyecto).
/// Solo se agregan registros; `aproximado` marca los reconstruidos a partir de createdAt/updatedAt.
model HistorialEtapa {
  id          Int              @id @default(autoincrement())
  solicitudId Int
  solicitud   Solicitud        @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  etapa       EtapaSeguimiento
  fecha       DateTime         @default(now())
  usuarioId   Int?
  usuario     User?            @relation("UsuarioHistorial", fields: [usuarioId], references: [id], onDelete: SetNull)
  aproximado  Boolean          @default(false)

  @@index([solicitudId, fecha])
  @@index([etapa, fecha])
}
